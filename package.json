{
  "name": "altec-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean:public": "node scripts/clean-public-assets.mjs",
    "audit:code-style": "node scripts/audit-code-style.mjs",
    "audit:downloads": "node scripts/audit-download-links.mjs",
    "audit:images": "node scripts/audit-image-assets.mjs",
    "audit:product-details": "node scripts/audit-product-structured-details.mjs",
    "audit:production-performance": "node scripts/audit-production-performance.mjs",
    "deploy:aliyun:oss": "npm run verify && npm run sync:site:oss",
    "docker:build": "docker build -t altec-web:local .",
    "docker:run": "docker run --rm -p 3000:80 altec-web:local",
    "prepare:aliyun": "npm run verify && npm run package:aliyun",
    "package:aliyun": "node scripts/package-aliyun-virtual-host.mjs",
    "prewarm:downloads": "node scripts/prewarm-downloads-cdn.mjs",
    "upload:cdn-cert": "node scripts/upload-cdn-cert.mjs",
    "sync:downloads:oss": "node scripts/sync-downloads-to-oss.mjs",
    "sync:site:oss": "node scripts/sync-site-to-oss.mjs",
    "promote:product-images": "node scripts/promote-product-images.mjs",
    "optimize:images": "node scripts/generate-optimized-images.mjs",
    "prebuild": "npm run clean:public && npm run optimize:images",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "npm run clean:public && npm run lint && npm run audit:code-style && npm run audit:images && npm run audit:product-details && npm run audit:downloads && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ali-oss": "^6.23.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
